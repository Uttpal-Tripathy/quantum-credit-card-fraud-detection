# Copy this file to .env and fill in real values. Never commit .env.
# IBM Quantum / Qiskit Runtime credentials (optional — only needed for backend=ibm_quantum)
IBM_QUANTUM_TOKEN=
IBM_QUANTUM_INSTANCE=
IBM_QUANTUM_CHANNEL=ibm_quantum_platform

# Kaggle API credentials (optional — only needed for scripts/download_data.py)
KAGGLE_USERNAME=
KAGGLE_KEY=

# Project-wide random seed override (optional)
QGFDA_RANDOM_SEED=42

# --- Live web app (FastAPI backend + HTML5 frontend), see api/main.py ---
# development | production. production disables /docs, /redoc, /openapi.json
# and hides internal exception details from API error responses.
ENVIRONMENT=development
# Host/port uvicorn binds to.
API_HOST=0.0.0.0
API_PORT=8000
# Enable auto-reload during development (ignored when ENVIRONMENT=production).
API_RELOAD=false
# Comma-separated list of allowed CORS origins, or * for any origin.
# Tighten this to your actual frontend origin(s) before deploying publicly.
API_CORS_ORIGINS=*
# How often (seconds) the real-time WebSocket feed scores + broadcasts a
# fresh synthetic transaction. See api/live_feed.py.
LIVE_FEED_INTERVAL_SECONDS=3
# Requests per minute allowed per client IP on the expensive endpoints
# (experiment runs, circuit rendering, feature selection). See
# api/main.py's RateLimitMiddleware.
RATE_LIMIT_PER_MINUTE=20
