# Copy this file to .env and fill in real values. Never commit .env.
# IBM Quantum / Qiskit Runtime credentials (optional — only needed for backend=ibm_quantum)
IBM_QUANTUM_TOKEN=
IBM_QUANTUM_INSTANCE=
IBM_QUANTUM_CHANNEL=ibm_quantum_platform

# Kaggle API credentials (optional — only needed for scripts/download_data.py)
KAGGLE_USERNAME=
KAGGLE_KEY=

# Project-wide random seed override (optional)
QGFDA_RANDOM_SEED=42

# --- Live web app (FastAPI backend + HTML5 frontend), see api/main.py ---
# Host/port uvicorn binds to.
API_HOST=0.0.0.0
API_PORT=8000
# Enable auto-reload during development (never enable in production).
API_RELOAD=false
# Comma-separated list of allowed CORS origins, or * for any origin.
# Tighten this to your actual frontend origin(s) before deploying publicly.
API_CORS_ORIGINS=*
